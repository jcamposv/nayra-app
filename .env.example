# Base de la API de Nayra: la app Next.js que sirve /api/client/v1.
# NO es la URL de Supabase — la app nunca habla con Supabase directamente.
#
# Simulador: localhost. iPhone físico: la IP de la Mac en la Wi-Fi
# (`ipconfig getifaddr en0`). Producción: https://app.nayraphoto.com
EXPO_PUBLIC_API_URL=http://localhost:3000
